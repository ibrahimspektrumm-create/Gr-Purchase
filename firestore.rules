// ════════════════════════════════════════════════════════════════
// GR Purchase v3 — Firestore Security Rules
// ════════════════════════════════════════════════════════════════
//
// Data model:
//   /users/{uid}                          → user profile + roles
//   /branches/{branchId}/
//       meta                              → branch config + columns
//       sheets/{sheetName}/rows/{rowId}   → cell data
//       sheets/{sheetName}/meta           → column defs + boundaries
//       log/{logId}                       → activity log
//   /config/system                        → global system config (admin only)
//
// Roles:
//   admin  → full access to all branches
//   user   → read/write only to allowed branches in their profile
// ════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────

    // Is the requesting user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Get the caller's user document (cached in a let for efficiency)
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Is the caller an admin?
    function isAdmin() {
      return isAuth() && userDoc().role == 'admin';
    }

    // Does the caller have access to a specific branch?
    function hasBranchAccess(branchId) {
      return isAuth() && (
        isAdmin() ||
        branchId in userDoc().branches
      );
    }

    // Is the caller's account active (not disabled)?
    function isActive() {
      return isAuth() && userDoc().get('disabled', false) == false;
    }

    // Validate that only allowed fields are being written
    function onlyFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    // Check incoming data size isn't excessively large
    function withinSizeLimit() {
      return request.resource.data.size() < 1048576; // 1MB per doc
    }

    // ── /users/{uid} ──────────────────────────────────────────

    match /users/{uid} {
      // Users can read their own profile
      allow read: if isAuth() && request.auth.uid == uid;

      // Admins can read all user profiles
      allow read: if isAdmin();

      // Users can update their own non-sensitive fields
      allow update: if isAuth()
        && request.auth.uid == uid
        && isActive()
        && onlyFields(['displayName', 'lastSeen', 'preferences', 'updatedAt']);

      // Only admins can create / delete / fully update user docs
      allow create, delete: if isAdmin();
      allow update: if isAdmin() && withinSizeLimit();
    }

    // ── /branches/{branchId} ─────────────────────────────────

    match /branches/{branchId} {

      // Branch-level metadata (config, column definitions)
      match /meta/{doc} {
        allow read:   if isActive() && hasBranchAccess(branchId);
        allow write:  if isActive() && hasBranchAccess(branchId) && withinSizeLimit();
        // Only admins can delete branch metadata
        allow delete: if isAdmin();
      }

      // ── Sheets ──────────────────────────────────────────────
      match /sheets/{sheetName} {

        // Sheet-level meta (column defs, invoice boundaries)
        allow read:  if isActive() && hasBranchAccess(branchId);
        allow write: if isActive() && hasBranchAccess(branchId) && withinSizeLimit();

        // Row data
        match /rows/{rowId} {
          allow read:   if isActive() && hasBranchAccess(branchId);

          allow create: if isActive()
            && hasBranchAccess(branchId)
            && withinSizeLimit()
            // Require server timestamp on new rows
            && request.resource.data.get('_createdAt', null) != null;

          allow update: if isActive()
            && hasBranchAccess(branchId)
            && withinSizeLimit()
            // Must include updatedAt timestamp
            && request.resource.data.get('_updatedAt', null) != null
            // Cannot change the original creator
            && (
              !('_createdBy' in request.resource.data) ||
              request.resource.data._createdBy == resource.data.get('_createdBy', request.auth.uid)
            );

          allow delete: if isActive()
            && hasBranchAccess(branchId);
        }
      }

      // ── Activity Log ─────────────────────────────────────────
      match /log/{logId} {
        // Anyone with branch access can read the log
        allow read:   if isActive() && hasBranchAccess(branchId);

        // Log entries are append-only (no update/delete for regular users)
        allow create: if isActive()
          && hasBranchAccess(branchId)
          && withinSizeLimit()
          && request.resource.data.keys().hasAll(['action','uid','timestamp'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.timestamp == request.time;

        // Only admins can update or delete log entries
        allow update, delete: if isAdmin();
      }
    }

    // ── /config/system ───────────────────────────────────────
    match /config/system {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    // ── Deny everything else ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
